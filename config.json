{
    "discord": {
        "webhook_url": "",
        "send_message_when_no_breakouts": true,
        "username": "Breakout Scanner",
        "request_timeout_seconds": 15
    },
    "data": {
        "sp500_source_url": "https://en.wikipedia.org/wiki/List_of_S%26P_500_companies",
        "download_period": "2y",
        "download_interval": "1d"
    },
    "breakout_strategy": {
        "enabled": true,
        "consolidation_window_days": 312,
        "max_consolidation_range_pct": 0.38,
        "breakout_multiplier": 1.01,
        "min_candle_body_pct": 0.01,
        "volume_sma_days": 30,
        "volume_surge_multiplier": 1.1,
        "near_miss_max_gap_pct": 0.01
    },
    "pullback_strategy": {
        "enabled": true,
        "sma_days": 150,
        "touch_band_pct": 0.02,
        "trend_lookback_days": 252,
        "sma_slope_lookback_days": 63,
        "min_days_above_sma_pct": 0.85,
        "max_candle_body_pct": 0.01,
        "min_candle_range_pct": 0.03,
        "require_reversal_candle": false,
        "alert_only_on_band_entry": true
    },
    "reclaim_strategy": {
        "enabled": false,
        "sma_days": 180,
        "below_lookback_days": 200,
        "min_days_below_pct": 0.8,
        "cross_margin_pct": 0.01,
        "min_candle_body_pct": 0.0,
        "min_day_gain_pct": null,
        "volume_sma_days": 30,
        "volume_surge_multiplier": 1.2,
        "sma_slope_lookback_days": 30,
        "min_sma_slope_pct": null,
        "alert_only_on_cross": true
    },
    "exit_strategy": {
        "enabled": true,
        "recent_window_days": 20,
        "prior_window_days": 90,
        "max_peak_diff_pct": 0.03,
        "min_trough_depth_pct": 0.05,
        "break_confirm_pct": 0.005,
        "volume_sma_days": 30,
        "min_volume_ratio": null,
        "alert_only_on_break": true,
        "discord_alert": true
    },
    "charts": {
        "enabled": true,
        "partial_charts": true,
        "lookback_days": 250,
        "dpi": 120
    },
    "backtest": {
        "years": 3,
        "holding_days": [10, 30, 60],
        "entry_delay_days": [0, 1, 2, 3, 4, 5],
        "entry": "next_open",
        "detail": {"entry_delay_days": 0, "holding_days": 30},
        "split_by_tier": false,
        "measure_excursions": true,
        "benchmark_ticker": "SPY",
        "cache_path": "backtest_universe_cache.pkl",
        "cache_max_age_days": 1,
        "screens": ["breakout_strategy", "pullback_strategy", "reclaim_strategy"],
        "output": {
            "trades_csv": "backtest_universe_trades.csv",
            "summary_csv": "backtest_universe_summary.csv",
            "chart_path": "backtest_universe.png",
            "grid_chart_path": "backtest_universe_grid.png",
            "chart_dpi": 120
        }
    },
    "tuning": {
        "years": 5,
        "holding_days": [30, 60],
        "protected_cases": [
            {"screen": "reclaim_strategy", "ticker": "META", "date": "2023-02-02",
             "note": "Stage-2 turn after the 2022 collapse; +23.3% day, 2.9% body"},
            {"screen": "breakout_strategy", "ticker": "JNJ", "date": "2025-09-30",
             "note": "the original breakout validation case"},
            {"screen": "pullback_strategy", "ticker": "MSFT", "date": "2024-04-30",
             "note": "the original pullback validation case"}
        ],
        "sweeps": {
            "breakout_strategy": {
                "consolidation_window_days": [126, 252, 312],
                "max_consolidation_range_pct": [0.2, 0.3, 0.38, 0.5],
                "breakout_multiplier": [1.0, 1.005, 1.01, 1.02],
                "min_candle_body_pct": [0.0, 0.005, 0.01, 0.02],
                "volume_surge_multiplier": [1.0, 1.1, 1.3, 1.5],
                "near_miss_max_gap_pct": [0.005, 0.01, 0.03, 0.05]
            },
            "pullback_strategy": {
                "sma_days": [100, 150, 200],
                "touch_band_pct": [0.01, 0.02, 0.03],
                "min_days_above_sma_pct": [0.75, 0.85, 0.9],
                "require_reversal_candle": [true, false],
                "max_candle_body_pct": [0.005, 0.01, 0.02],
                "min_candle_range_pct": [0.02, 0.03, 0.04]
            },
            "reclaim_strategy": {
                "min_days_below_pct": [0.6, 0.7, 0.8, 0.9],
                "below_lookback_days": [100, 150, 200, 250],
                "cross_margin_pct": [0.005, 0.01, 0.02, 0.025],
                "min_candle_body_pct": [0.0, 0.01, 0.02, 0.03],
                "min_day_gain_pct": [null, 0.03, 0.05],
                "volume_surge_multiplier": [1.0, 1.2, 1.5],
                "sma_slope_lookback_days": [21, 30, 63],
                "min_sma_slope_pct": [null, -0.2, -0.15, -0.1, -0.05]
            }
        },
        "grid": {
            "reclaim_strategy": ["min_sma_slope_pct", "min_candle_body_pct",
                                 "cross_margin_pct"],
            "breakout_strategy": ["max_consolidation_range_pct",
                                  "min_candle_body_pct",
                                  "volume_surge_multiplier"],
            "pullback_strategy": ["touch_band_pct", "min_days_above_sma_pct",
                                  "require_reversal_candle"]
        }
    },
    "fundamentals": {
        "enabled": true,
        "fields": {
            "trailingPE": "P/E",
            "trailingPegRatio": "PEG",
            "debtToEquity": "Total Debt/Equity",
            "revenueGrowth": "Rev YoY %",
            "dividendYield": "Div Yield %",
            "payoutRatio": "Payout %"
        },
        "percent_fields": ["revenueGrowth", "payoutRatio"],
        "statements": {
            "enabled": true,
            "years": 2,
            "metrics": {
                "fcf": "FCF",
                "operating_margin": "OpM",
                "profit_margin": "PM",
                "roe": "ROE",
                "roic": "ROIC"
            }
        },
        "quality": {
            "enabled": true,
            "badge": "⭐",
            "rules": {
                "trailingPE": {"max": 37},
                "trailingPegRatio": {"max": 2.1},
                "debtToEquity": {"max": 85},
                "revenueGrowth": {"min": 10},
                "dividendYield": {"min": 0},
                "payoutRatio": {"max": 60},
                "roe": {"min": 12},
                "roic": {"min": 12},
                "operating_margin": {"min": 10, "increasing": true},
                "profit_margin": {"min": 10, "increasing": true},
                "fcf": {"min": 0, "increasing": true}
            }
        }
    },
    "quality": {
        "enabled": true,
        "badge": "⭐",
        "tiers": [
            {"label": "STRONG", "min": 80, "color": "2E9C6B"},
            {"label": "WATCH", "min": 45, "color": "2A78D6"},
            {"label": "PASS", "min": 0, "color": "898781"}
        ],
        "groups": {
            "valuation": {"enabled": true, "weight": 0.16},
            "growth": {"enabled": true, "weight": 0.16},
            "estimate_momentum": {"enabled": true, "weight": 0.13},
            "earnings_quality": {"enabled": true, "weight": 0.10},
            "financial_quality": {"enabled": true, "weight": 0.24},
            "analyst_sentiment": {"enabled": true, "weight": 0.11},
            "shareholder_returns": {"enabled": true, "weight": 0.10}
        },
        "parameters": {
            "trailingPE": {
                "enabled": true, "label": "P/E", "source": "yahoo_info.trailingPE",
                "group": "valuation", "stage": "fast", "weight": 1.0,
                "display": true, "format": "number",
                "gate": {"max": 37}, "score": {"good": 12, "bad": 45}
            },
            "trailingPegRatio": {
                "enabled": true, "label": "PEG", "source": "yahoo_info.trailingPegRatio",
                "group": "valuation", "stage": "fast", "weight": 1.0,
                "display": true, "format": "number",
                "gate": {"max": 2.1}, "score": {"good": 0.8, "bad": 3.0}
            },
            "debtToEquity": {
                "enabled": true, "label": "Total Debt/Equity",
                "source": "yahoo_info.debtToEquity",
                "group": "financial_quality", "stage": "fast", "weight": 1.0,
                "display": true, "format": "number",
                "gate": {"max": 85}, "score": {"good": 20, "bad": 150}
            },
            "revenueGrowth": {
                "enabled": true, "label": "Rev YoY %", "source": "yahoo_info.revenueGrowth",
                "group": "growth", "stage": "fast", "weight": 1.0,
                "display": true, "format": "number", "percent": true,
                "gate": {"min": 10}, "score": {"good": 20, "bad": 0}
            },
            "dividendYield": {
                "enabled": true, "label": "Div Yield %", "source": "yahoo_info.dividendYield",
                "group": "shareholder_returns", "stage": "fast", "weight": 1.0,
                "display": true, "format": "number",
                "gate": {"min": 0}, "score": {"good": 3, "bad": 0}
            },
            "payoutRatio": {
                "enabled": true, "label": "Payout %", "source": "yahoo_info.payoutRatio",
                "group": "shareholder_returns", "stage": "fast", "weight": 1.0,
                "display": true, "format": "number", "percent": true,
                "gate": {"max": 60}, "score": {"good": 30, "bad": 80}
            },
            "roe": {
                "enabled": true, "label": "ROE", "source": "yahoo_stmt.roe",
                "group": "financial_quality", "stage": "fast", "weight": 1.0,
                "display": true, "format": "pct",
                "gate": {"min": 12}, "score": {"good": 25, "bad": 5}
            },
            "roic": {
                "enabled": true, "label": "ROIC", "source": "yahoo_stmt.roic",
                "group": "financial_quality", "stage": "fast", "weight": 1.0,
                "display": true, "format": "pct",
                "gate": {"min": 12}, "score": {"good": 20, "bad": 4}
            },
            "operating_margin": {
                "enabled": true, "label": "OpM", "source": "yahoo_stmt.operating_margin",
                "group": "financial_quality", "stage": "fast", "weight": 1.0,
                "display": true, "format": "pct_series",
                "gate": {"min": 10, "increasing": true}, "score": {"good": 30, "bad": 5}
            },
            "profit_margin": {
                "enabled": true, "label": "PM", "source": "yahoo_stmt.profit_margin",
                "group": "financial_quality", "stage": "fast", "weight": 1.0,
                "display": true, "format": "pct_series",
                "gate": {"min": 10, "increasing": true}, "score": {"good": 20, "bad": 3}
            },
            "fcf": {
                "enabled": true, "label": "FCF", "source": "yahoo_stmt.fcf",
                "group": "financial_quality", "stage": "fast", "weight": 1.0,
                "display": true, "format": "money_series",
                "gate": {"min": 0, "increasing": true}, "score": null
            },
            "pe_percentile_2y": {
                "enabled": true, "label": "P/E pctile 2y",
                "source": "yahoo_deep.pe_percentile_2y",
                "group": "valuation", "stage": "deep", "weight": 1.0,
                "display": false, "format": "number",
                "gate": null, "score": {"good": 10, "bad": 90}
            },
            "analyst_upside_pct": {
                "enabled": true, "label": "Upside %", "source": "yahoo_deep.analyst_upside_pct",
                "group": "valuation", "stage": "deep", "weight": 1.0,
                "display": false, "format": "pct",
                "gate": null, "score": {"good": 25, "bad": -10}
            },
            "growth_this_year_pct": {
                "enabled": true, "label": "Growth FY0",
                "source": "yahoo_deep.growth_this_year_pct",
                "group": "growth", "stage": "deep", "weight": 1.0,
                "display": false, "format": "pct",
                "gate": null, "score": {"good": 20, "bad": 0}
            },
            "growth_next_year_pct": {
                "enabled": true, "label": "Growth FY1",
                "source": "yahoo_deep.growth_next_year_pct",
                "group": "growth", "stage": "deep", "weight": 1.0,
                "display": false, "format": "pct",
                "gate": null, "score": {"good": 15, "bad": 0}
            },
            "eps_revision_net": {
                "enabled": true, "label": "EPS revisions",
                "source": "yahoo_deep.eps_revision_net",
                "group": "estimate_momentum", "stage": "deep", "weight": 1.0,
                "display": false, "format": "number",
                "gate": null, "score": {"good": 0.6, "bad": -0.4}
            },
            "eps_trend_change": {
                "enabled": true, "label": "EPS trend 90d",
                "source": "yahoo_deep.eps_trend_change",
                "group": "estimate_momentum", "stage": "deep", "weight": 1.0,
                "display": false, "format": "number",
                "gate": null, "score": {"good": 0.05, "bad": -0.05}
            },
            "earnings_avg_surprise": {
                "enabled": true, "label": "Avg surprise %",
                "source": "yahoo_deep.earnings_avg_surprise",
                "group": "earnings_quality", "stage": "deep", "weight": 1.0,
                "display": false, "format": "pct",
                "gate": null, "score": {"good": 8, "bad": -2}
            },
            "earnings_beat_rate": {
                "enabled": true, "label": "Beat rate",
                "source": "yahoo_deep.earnings_beat_rate",
                "group": "earnings_quality", "stage": "deep", "weight": 1.0,
                "display": false, "format": "number",
                "gate": null, "score": {"good": 1.0, "bad": 0.5}
            },
            "return_on_assets": {
                "enabled": true, "label": "ROA", "source": "yahoo_deep.return_on_assets",
                "group": "financial_quality", "stage": "deep", "weight": 1.0,
                "display": false, "format": "pct",
                "gate": null, "score": {"good": 15, "bad": 2}
            },
            "gross_margin": {
                "enabled": true, "label": "Gross margin",
                "source": "yahoo_deep.gross_margin",
                "group": "financial_quality", "stage": "deep", "weight": 1.0,
                "display": false, "format": "pct", "zero_is_missing": true,
                "gate": null, "score": {"good": 60, "bad": 20}
            },
            "net_debt_to_ebitda": {
                "enabled": true, "label": "Net debt/EBITDA",
                "source": "yahoo_deep.net_debt_to_ebitda",
                "group": "financial_quality", "stage": "deep", "weight": 1.0,
                "display": false, "format": "number",
                "gate": null, "score": {"good": 0, "bad": 4}
            },
            "buyback_2y": {
                "enabled": true, "label": "Share count 2y %",
                "source": "yahoo_deep.buyback_2y",
                "group": "shareholder_returns", "stage": "deep", "weight": 1.0,
                "display": false, "format": "pct",
                "gate": null, "score": {"good": -5, "bad": 3}
            },
            "analyst_buy_ratio": {
                "enabled": true, "label": "Analyst buy ratio",
                "source": "yahoo_deep.analyst_buy_ratio",
                "group": "analyst_sentiment", "stage": "deep", "weight": 1.0,
                "display": false, "format": "number",
                "gate": null, "score": {"good": 0.8, "bad": 0.3}
            },
            "ibkr_implied_volatility": {
                "enabled": true, "label": "IV (IBKR)",
                "source": "ibkr.implied_volatility",
                "group": "analyst_sentiment", "stage": "deep", "weight": 1.0,
                "display": false, "format": "number",
                "gate": null, "score": {"good": 0.2, "bad": 0.8}
            },
            "ibkr_return_on_equity": {
                "enabled": false, "label": "ROE (IBKR)",
                "source": "ibkr.return_on_equity",
                "group": "financial_quality", "stage": "deep", "weight": 1.0,
                "display": false, "format": "pct",
                "gate": null, "score": {"good": 25, "bad": 5}
            },
            "ibkr_revenue_growth_rate": {
                "enabled": false, "label": "Rev growth (IBKR)",
                "source": "ibkr.revenue_growth_rate",
                "group": "growth", "stage": "deep", "weight": 1.0,
                "display": false, "format": "pct",
                "gate": null, "score": {"good": 20, "bad": 0}
            }
        }
    },
    "ibkr": {
        "enabled": true,
        "host": "127.0.0.1",
        "port": 4001,
        "client_id": 17,
        "connect_timeout_seconds": 8,
        "request_timeout_seconds": 20,
        "market_data": true,
        "reports": [],
        "market_data_type": 3,
        "snapshot_wait_seconds": 8,
        "fundamental_ticks": false
    },
    "research": {
        "latest_hits_path": "latest_hits.json",
        "report_subdir": "reports",
        "auto": {
            "enabled": true,
            "gate": "all",
            "max_reports": 3,
            "discord_send": true
        },
        "narrative": {
            "enabled": true,
            "model": "opus"
        },
        "history": {
            "enabled": true,
            "dir": "history",
            "csv": "signals.csv",
            "on_demand_csv": "on_demand_scans_results.csv"
        },
        "logging": {
            "enabled": true,
            "dir": "logs",
            "manifest": "deepdive_runs.csv",
            "keep_runs": 200
        },
        "financials": {
            "years": 4,
            "quarters": 4,
            "chart_dpi": 120
        },
        "sec": {
            "user_agent": "stock-analyzer/1.0 (you@example.com)",
            "forms": ["10-Q", "10-K"],
            "max_section_chars": 24000,
            "xbrl_concepts": [
                "RevenueFromContractWithCustomerExcludingAssessedTax",
                "Revenues",
                "GrossProfit",
                "OperatingIncomeLoss",
                "NetIncomeLoss",
                "Assets",
                "Liabilities",
                "StockholdersEquity",
                "CashAndCashEquivalentsAtCarryingValue",
                "NetCashProvidedByUsedInOperatingActivities",
                "LongTermDebtNoncurrent"
            ]
        },
        "synthesis": {
            "narrative_adj_max": 15,
            "tiers": [
                {"label": "STRONG", "min": 80, "color": "2E9C6B"},
                {"label": "WATCH", "min": 45, "color": "2A78D6"},
                {"label": "PASS", "min": 0, "color": "898781"}
            ],
            "dimensions": {
                "valuation": {
                    "weight": 0.18,
                    "metrics": {
                        "pe_percentile_2y": {"good": 10, "bad": 90},
                        "analyst_upside_pct": {"good": 25, "bad": -10}
                    }
                },
                "growth": {
                    "weight": 0.18,
                    "metrics": {
                        "growth_this_year_pct": {"good": 20, "bad": 0},
                        "growth_next_year_pct": {"good": 15, "bad": 0}
                    }
                },
                "estimate_momentum": {
                    "weight": 0.15,
                    "metrics": {
                        "eps_revision_net": {"good": 0.6, "bad": -0.4},
                        "eps_trend_change": {"good": 0.05, "bad": -0.05}
                    }
                },
                "earnings_quality": {
                    "weight": 0.12,
                    "metrics": {
                        "earnings_avg_surprise": {"good": 8, "bad": -2},
                        "earnings_beat_rate": {"good": 1.0, "bad": 0.5}
                    }
                },
                "financial_quality": {
                    "weight": 0.22,
                    "metrics": {
                        "return_on_assets": {"good": 15, "bad": 2},
                        "gross_margin": {"good": 60, "bad": 20},
                        "net_debt_to_ebitda": {"good": 0, "bad": 4},
                        "buyback_2y": {"good": -5, "bad": 3}
                    }
                },
                "analyst_sentiment": {
                    "weight": 0.15,
                    "metrics": {
                        "analyst_buy_ratio": {"good": 0.8, "bad": 0.3}
                    }
                }
            }
        }
    },
    "portfolio": {
        "enabled": true,
        "dir": "portfolio",
        "positions_csv": "positions.csv",
        "findings_csv": "findings.csv",
        "exits_csv": "exits.csv",
        "entry": "next_open",
        "horizons": [10, 30, 60],
        "notional": 10000,
        "benchmark_ticker": "SPY",
        "measure_excursions": true,
        "analysis": {
            "min_n": 20,
            "alpha": 0.05,
            "bootstrap_iters": 2000,
            "fdr": true,
            "keep_dated_findings": true
        }
    }
}
