{
    "discord": {
        "webhook_url": "",
        "send_message_when_no_breakouts": true,
        "username": "Breakout Scanner",
        "request_timeout_seconds": 15
    },
    "data": {
        "sp500_source_url": "https://en.wikipedia.org/wiki/List_of_S%26P_500_companies",
        "download_period": "2y",
        "download_interval": "1d"
    },
    "breakout_strategy": {
        "enabled": true,
        "consolidation_window_days": 312,
        "max_consolidation_range_pct": 0.38,
        "breakout_multiplier": 1.01,
        "min_candle_body_pct": 0.01,
        "volume_sma_days": 30,
        "volume_surge_multiplier": 1.1,
        "near_miss_max_gap_pct": 0.01
    },
    "pullback_strategy": {
        "enabled": true,
        "sma_days": 150,
        "touch_band_pct": 0.02,
        "trend_lookback_days": 252,
        "sma_slope_lookback_days": 63,
        "min_days_above_sma_pct": 0.85,
        "max_candle_body_pct": 0.01,
        "min_candle_range_pct": 0.03,
        "require_reversal_candle": false,
        "alert_only_on_band_entry": true
    },
    "reclaim_strategy": {
        "enabled": false,
        "sma_days": 180,
        "below_lookback_days": 200,
        "min_days_below_pct": 0.8,
        "cross_margin_pct": 0.01,
        "min_candle_body_pct": 0.0,
        "min_day_gain_pct": null,
        "volume_sma_days": 30,
        "volume_surge_multiplier": 1.2,
        "sma_slope_lookback_days": 30,
        "min_sma_slope_pct": null,
        "alert_only_on_cross": true
    },
    "charts": {
        "enabled": true,
        "partial_charts": true,
        "lookback_days": 250,
        "dpi": 120
    },
    "backtest": {
        "years": 3,
        "holding_days": [10, 30, 60],
        "entry_delay_days": [0, 1, 2, 3, 4, 5],
        "entry": "next_open",
        "detail": {"entry_delay_days": 0, "holding_days": 30},
        "split_by_tier": false,
        "measure_excursions": true,
        "benchmark_ticker": "SPY",
        "cache_path": "backtest_universe_cache.pkl",
        "cache_max_age_days": 1,
        "screens": ["breakout_strategy", "pullback_strategy", "reclaim_strategy"],
        "output": {
            "trades_csv": "backtest_universe_trades.csv",
            "summary_csv": "backtest_universe_summary.csv",
            "chart_path": "backtest_universe.png",
            "grid_chart_path": "backtest_universe_grid.png",
            "chart_dpi": 120
        }
    },
    "tuning": {
        "years": 5,
        "holding_days": [30, 60],
        "protected_cases": [
            {"screen": "reclaim_strategy", "ticker": "META", "date": "2023-02-02",
             "note": "Stage-2 turn after the 2022 collapse; +23.3% day, 2.9% body"},
            {"screen": "breakout_strategy", "ticker": "JNJ", "date": "2025-09-30",
             "note": "the original breakout validation case"},
            {"screen": "pullback_strategy", "ticker": "MSFT", "date": "2024-04-30",
             "note": "the original pullback validation case"}
        ],
        "sweeps": {
            "breakout_strategy": {
                "consolidation_window_days": [126, 252, 312],
                "max_consolidation_range_pct": [0.2, 0.3, 0.38, 0.5],
                "breakout_multiplier": [1.0, 1.005, 1.01, 1.02],
                "min_candle_body_pct": [0.0, 0.005, 0.01, 0.02],
                "volume_surge_multiplier": [1.0, 1.1, 1.3, 1.5],
                "near_miss_max_gap_pct": [0.005, 0.01, 0.03, 0.05]
            },
            "pullback_strategy": {
                "sma_days": [100, 150, 200],
                "touch_band_pct": [0.01, 0.02, 0.03],
                "min_days_above_sma_pct": [0.75, 0.85, 0.9],
                "require_reversal_candle": [true, false],
                "max_candle_body_pct": [0.005, 0.01, 0.02],
                "min_candle_range_pct": [0.02, 0.03, 0.04]
            },
            "reclaim_strategy": {
                "min_days_below_pct": [0.6, 0.7, 0.8, 0.9],
                "below_lookback_days": [100, 150, 200, 250],
                "cross_margin_pct": [0.005, 0.01, 0.02, 0.025],
                "min_candle_body_pct": [0.0, 0.01, 0.02, 0.03],
                "min_day_gain_pct": [null, 0.03, 0.05],
                "volume_surge_multiplier": [1.0, 1.2, 1.5],
                "sma_slope_lookback_days": [21, 30, 63],
                "min_sma_slope_pct": [null, -0.2, -0.15, -0.1, -0.05]
            }
        },
        "grid": {
            "reclaim_strategy": ["min_sma_slope_pct", "min_candle_body_pct",
                                 "cross_margin_pct"],
            "breakout_strategy": ["max_consolidation_range_pct",
                                  "min_candle_body_pct",
                                  "volume_surge_multiplier"],
            "pullback_strategy": ["touch_band_pct", "min_days_above_sma_pct",
                                  "require_reversal_candle"]
        }
    },
    "fundamentals": {
        "enabled": true,
        "fields": {
            "trailingPE": "P/E",
            "trailingPegRatio": "PEG",
            "debtToEquity": "Total Debt/Equity",
            "revenueGrowth": "Rev YoY %",
            "dividendYield": "Div Yield %",
            "payoutRatio": "Payout %"
        },
        "percent_fields": ["revenueGrowth", "payoutRatio"],
        "statements": {
            "enabled": true,
            "years": 2,
            "metrics": {
                "fcf": "FCF",
                "operating_margin": "OpM",
                "profit_margin": "PM",
                "roe": "ROE",
                "roic": "ROIC"
            }
        },
        "quality": {
            "enabled": true,
            "badge": "⭐",
            "rules": {
                "trailingPE": {"max": 35},
                "trailingPegRatio": {"max": 2},
                "debtToEquity": {"max": 75},
                "revenueGrowth": {"min": 10},
                "dividendYield": {"min": 0},
                "payoutRatio": {"max": 50},
                "roe": {"min": 10},
                "roic": {"min": 10},
                "operating_margin": {"min": 20, "increasing": true},
                "profit_margin": {"min": 10, "increasing": true},
                "fcf": {"min": 0, "increasing": true}
            }
        }
    },
    "research": {
        "latest_hits_path": "latest_hits.json",
        "drive_report_dir": "C:\\Users\\Lenovo\\Desktop\\*Google Drive*",
        "report_subdir": "stock_reports",
        "sec": {
            "user_agent": "stock-analyzer/1.0 (you@example.com)",
            "forms": ["10-Q", "10-K"],
            "max_section_chars": 24000,
            "xbrl_concepts": [
                "RevenueFromContractWithCustomerExcludingAssessedTax",
                "Revenues",
                "GrossProfit",
                "OperatingIncomeLoss",
                "NetIncomeLoss",
                "Assets",
                "Liabilities",
                "StockholdersEquity",
                "CashAndCashEquivalentsAtCarryingValue",
                "NetCashProvidedByUsedInOperatingActivities",
                "LongTermDebtNoncurrent"
            ]
        },
        "synthesis": {
            "narrative_adj_max": 15,
            "tiers": [
                {"label": "STRONG", "min": 70},
                {"label": "WATCH", "min": 45},
                {"label": "PASS", "min": 0}
            ],
            "dimensions": {
                "valuation": {
                    "weight": 0.18,
                    "metrics": {
                        "pe_percentile_2y": {"good": 10, "bad": 90},
                        "analyst_upside_pct": {"good": 25, "bad": -10}
                    }
                },
                "growth": {
                    "weight": 0.18,
                    "metrics": {
                        "growth_this_year_pct": {"good": 20, "bad": 0},
                        "growth_next_year_pct": {"good": 15, "bad": 0}
                    }
                },
                "estimate_momentum": {
                    "weight": 0.15,
                    "metrics": {
                        "eps_revision_net": {"good": 0.6, "bad": -0.4},
                        "eps_trend_change": {"good": 0.05, "bad": -0.05}
                    }
                },
                "earnings_quality": {
                    "weight": 0.12,
                    "metrics": {
                        "earnings_avg_surprise": {"good": 8, "bad": -2},
                        "earnings_beat_rate": {"good": 1.0, "bad": 0.5}
                    }
                },
                "financial_quality": {
                    "weight": 0.22,
                    "metrics": {
                        "return_on_assets": {"good": 15, "bad": 2},
                        "gross_margin": {"good": 60, "bad": 20},
                        "net_debt_to_ebitda": {"good": 0, "bad": 4},
                        "buyback_2y": {"good": -5, "bad": 3}
                    }
                },
                "analyst_sentiment": {
                    "weight": 0.15,
                    "metrics": {
                        "analyst_buy_ratio": {"good": 0.8, "bad": 0.3}
                    }
                }
            }
        }
    }
}
