{
    "discord": {
        "webhook_url": "",
        "send_message_when_no_breakouts": true,
        "username": "Breakout Scanner",
        "request_timeout_seconds": 15
    },
    "data": {
        "sp500_source_url": "https://en.wikipedia.org/wiki/List_of_S%26P_500_companies",
        "download_period": "2y",
        "download_interval": "1d"
    },
    "strategy": {
        "enabled": true,
        "consolidation_window_days": 312,
        "max_consolidation_range_pct": 0.32,
        "breakout_multiplier": 1.01,
        "volume_sma_days": 30,
        "volume_surge_multiplier": 1.1,
        "near_miss_max_gap_pct": 0.05
    },
    "pullback_strategy": {
        "enabled": true,
        "sma_days": 150,
        "touch_band_pct": 0.02,
        "trend_lookback_days": 252,
        "sma_slope_lookback_days": 63,
        "min_days_above_sma_pct": 0.85,
        "alert_only_on_band_entry": true
    },
    "reclaim_strategy": {
        "enabled": true,
        "sma_days": 200,
        "below_lookback_days": 200,
        "min_days_below_pct": 0.8,
        "cross_margin_pct": 0.01,
        "volume_sma_days": 30,
        "volume_surge_multiplier": 1.2,
        "sma_slope_lookback_days": 63,
        "min_sma_slope_pct": null,
        "alert_only_on_cross": true
    },
    "charts": {
        "enabled": true,
        "near_miss_charts": false,
        "lookback_days": 250,
        "dpi": 120
    },
    "fundamentals": {
        "enabled": true,
        "fields": {
            "trailingPE": "P/E",
            "trailingPegRatio": "PEG",
            "debtToEquity": "Total Debt/Equity",
            "revenueGrowth": "Rev YoY %",
            "dividendYield": "Div Yield %",
            "payoutRatio": "Payout %"
        },
        "percent_fields": ["revenueGrowth", "payoutRatio"],
        "statements": {
            "enabled": true,
            "years": 2,
            "metrics": {
                "fcf": "FCF",
                "operating_margin": "OpM",
                "profit_margin": "PM",
                "roe": "ROE",
                "roic": "ROIC"
            }
        },
        "quality": {
            "enabled": true,
            "badge": "⭐",
            "rules": {
                "trailingPE": {"max": 35},
                "trailingPegRatio": {"max": 2},
                "debtToEquity": {"max": 75},
                "revenueGrowth": {"min": 10},
                "dividendYield": {"min": 0},
                "payoutRatio": {"max": 50},
                "roe": {"min": 15},
                "roic": {"min": 15},
                "operating_margin": {"min": 20, "increasing": true},
                "profit_margin": {"min": 15, "increasing": true},
                "fcf": {"min": 0, "increasing": true}
            }
        }
    }
}
