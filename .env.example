# Copy this file to `.env` (git-ignored) and fill in the values.
#
# Nothing here is read at import time: `scanner_common.load_config()` resolves
# it on every run, so a change takes effect on the next command with no reload.
# Precedence is environment variable -> .env -> config.json.

# Discord webhook for the nightly alert.
#   Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
# Leave it empty and the scan prints its cards to the console instead of
# posting them -- which is exactly what `run_scanners.py --no-send` does.
STOCK_ANALYZER_DISCORD_WEBHOOK=

# Contact for the SEC EDGAR User-Agent header. Their fair-access policy requires
# a real contact in it, and both data.sec.gov and efts.sec.gov refuse requests
# without one, so put a working address here. Format is product/version and the
# address in parentheses:
#   STOCK_ANALYZER_SEC_USER_AGENT=stock-analyzer/1.0 (you@example.com)
# Left empty, a clearly-placeholder value goes out and the step log says so once.
STOCK_ANALYZER_SEC_USER_AGENT=
